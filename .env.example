# Clave de Django; obligatoria en producción cuando DEBUG=False.
SECRET_KEY=
DEBUG=True

# Si está vacía, se usa SQLite local. En Render, configurar la URL de PostgreSQL.
DATABASE_URL=

# Clave requerida por el sensor en el header HTTP X-API-Key.
INGEST_API_KEY=

# Umbral para considerar un nodo desconectado y opciones de alertas/registro.
NODE_OFFLINE_THRESHOLD_SECONDS=300
ALERT_ON_WARNING=False
AUTO_REGISTER_NODES=False

# Lecturas recientes que cada nodo guarda en memoria para /nodes/{id}/recent/.
RECENT_READINGS_PER_NODE=50
# Lecturas que cubre la ventana de temperatura máxima y mínima de /nodes/{id}/status/.
TEMPERATURE_WINDOW_SIZE=20
# Nodos cuyo /nodes/{id}/status/ se guarda en una caché LRU en memoria (0 la desactiva).
NODE_STATUS_CACHE_SIZE=256
# Segundos que se reutiliza el resumen de /dashboard/summary/ (0 lo desactiva).
DASHBOARD_CACHE_SECONDS=5

# Descartar lecturas repetidas (mismo nodo y timestamp) y cuántas recuerda el filtro de Bloom.
DEDUPLICATE_READINGS=True
# Saltos hacia los vecinos a los que se avisa cuando un nodo entra en FIRE (0 lo desactiva).
NEIGHBOR_WARNING_HOPS=2

# Días que se conservan las lecturas antes de que `manage.py purge_readings` las borre.
READINGS_RETENTION_DAYS=90
DUPLICATE_FILTER_CAPACITY=100000

# Servicio PyroGuard-IA. Vacía deshabilita la IA y se usan solo las reglas.
# Local: http://127.0.0.1:8001 (sin barra final).
AI_SERVICE_URL=
# Segundos máximos para establecer la conexión con la IA (detecta caídas rápido).
AI_CONNECT_TIMEOUT=3.0
# Segundos máximos de espera de la respuesta de inferencia una vez conectado.
AI_READ_TIMEOUT=10.0
# Si es True, la ingesta responde sin esperar a la IA y `manage.py drain_ai_queue` la evalúa después.
AI_ASYNC_EVALUATION=False
# Debe coincidir con AI_API_KEY del servicio IA (header X-AI-API-Key).
AI_API_KEY=

# Nivel de logs y listas adicionales separadas por comas.
LOG_LEVEL=INFO
EXTRA_ALLOWED_HOSTS=
EXTRA_CORS_ORIGINS=

# Notificaciones: canales activos separados por comas (console, email, telegram).
NOTIFICATION_CHANNELS=console
# Intentos de envío de un aviso antes de darlo por fallido.
NOTIFICATION_MAX_ATTEMPTS=3
# Correo: destinatarios separados por comas y datos SMTP.
NOTIFY_EMAIL_TO=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
# Telegram: token del bot (BotFather) y chat al que se envía.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
