[run]
source = api, config
branch = True
omit =
    */migrations/*
    */tests.py
    api/test_*.py

[report]
show_missing = True
# El CI falla si la cobertura baja de este mínimo (99 % de líneas y ramas al cerrar la Fase 13).
fail_under = 98
skip_covered = True
exclude_also =
    if __name__ == .__main__.:
